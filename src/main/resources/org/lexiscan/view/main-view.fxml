<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.SVGPath?>

<!--BorderPane divides the application into a fixed sidebar and a
    flexible main content area.-->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.lexiscan.controller.MainController" styleClass="root">

    <!-- SIDEBAR -->
    <!--The sidebar contains the application branding and the main
        navigation. Additional navigation options can be added here
        if the application grows in the future.-->
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0" spacing="30.0">

            <padding>
                <Insets top="35.0" right="20.0" bottom="25.0" left="20.0"/>
            </padding>

            <!-- Branding -->
            <VBox spacing="4.0">

                <HBox alignment="CENTER_LEFT" spacing="10.0">

                    <ImageView fitWidth="45.0"
                               fitHeight="45.0"
                               preserveRatio="true">
                        <image>
                            <Image url="@img/LexiScan_logo.png"/>
                        </image>
                    </ImageView>

                    <Label text="LexiScan" styleClass="logo"/>

                </HBox>

                <Label text="Analiza. Cuenta. Descubre." styleClass="tagline"/>

            </VBox>

            <!-- Navigation -->
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">

                <Button text="Analizador de Texto" styleClass="navigation-button" maxWidth="Infinity">
                    <graphic>
                        <!-- Ícono de Documento -->
                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" style="-fx-fill: white;"/>
                    </graphic>
                </Button>

            </VBox>

        </VBox>
    </left>


    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">

            <VBox styleClass="content" spacing="25.0">

                <padding>
                    <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
                </padding>


                <!-- HEADER -->
                <VBox spacing="6.0">

                    <Label text="Analizador de Texto" styleClass="page-title"/>

                    <Label text="Introduce o pega un texto para analizar sus componentes." styleClass="page-subtitle"/>

                </VBox>


                <!-- WORKSPACE -->
                <HBox spacing="25.0" VBox.vgrow="ALWAYS">

                    <!-- LEFT COLUMN -->
                    <VBox spacing="25.0" HBox.hgrow="ALWAYS">


                        <!-- INPUT CARD -->
                        <!--This section contains the text entered by the user and the
                            controls used to start or reset the analysis.-->
                        <VBox styleClass="card" spacing="18.0">

                            <!-- Header -->
                            <HBox alignment="CENTER_LEFT">

                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <!-- Ícono de Documento -->
                                    <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" style="-fx-fill: white;"/>
                                    <Label text="Texto de entrada" styleClass="card-title"/>
                                </HBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <!--Displays the current number of characters in the input.
                                The controller updates this value as the user types.-->
                                <Label fx:id="characterCountLabel" text="0 caracteres" styleClass="character-count"/>

                            </HBox>

                            <!-- Text input -->
                            <TextArea fx:id="textInput" promptText="Escribe o pega tu texto aquí..." wrapText="true" prefRowCount="10" styleClass="text-input"/>

                            <!-- Actions -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0">

                                <Button fx:id="clearButton" text="Limpiar" styleClass="secondary-button">
                                    <graphic>
                                        <!-- Ícono de Basurero gris -->
                                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" style="-fx-fill: #8E9AAB;"/>
                                    </graphic>
                                </Button>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button fx:id="analyzeButton" text="▶  Analizar" styleClass="primary-button"/>

                            </HBox>

                        </VBox>


                        <!-- HIGHLIGHT CARD -->
                        <VBox styleClass="card" spacing="15.0">

                            <Label text="Texto analizado" styleClass="card-title"/>

                            <Label text="Selecciona una categoría para resaltar sus elementos." styleClass="card-subtitle"/>

                            <!-- TextFlow is used instead of a Label because individual characters
                            need to be styled independently when highlighting vowels, consonants,
                            digits, or special characters.-->
                            <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="highlight-scroll">

                                <TextFlow fx:id="highlightedText" styleClass="highlight-text"/>

                            </ScrollPane>

                        </VBox>


                        <!-- EXAMPLES -->
                        <VBox styleClass="card" spacing="15.0">

                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <!-- Ícono de Foco amarillo -->
                                <SVGPath content="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm2.85 11.1l-.85.6V16h-4v-2.3l-.85-.6C7.8 12.16 7 10.63 7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.63-.8 3.16-2.15 4.1z" style="-fx-fill: #F4D35E;"/>
                                <Label text="Ejemplos" styleClass="card-title"/>
                            </HBox>

                            <Label text="Puedes probar con alguno de estos ejemplos:" styleClass="card-subtitle"/>

                            <HBox spacing="10.0">

                                <Button fx:id="exampleOneButton" text="¡Hola, mundo!" styleClass="example-button" HBox.hgrow="ALWAYS"/>

                                <Button fx:id="exampleTwoButton" text="La vida es mejor con código." styleClass="example-button" HBox.hgrow="ALWAYS"/>

                                <Button fx:id="exampleThreeButton" text="123.45 @#%" styleClass="example-button" HBox.hgrow="ALWAYS"/>

                            </HBox>

                        </VBox>

                    </VBox>


                    <!-- RESULTS -->
                    <!--Each result item displays the count of one category and includes
                        a RadioButton so the user can select which category to highlight
                        in the analyzed text.-->
                    <VBox styleClass="results-card" spacing="18.0" prefWidth="360.0">

                        <!-- Results header -->
                        <VBox spacing="4.0">

                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <!-- Ícono de Gráfico (Encuesta) morado -->
                                <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" style="-fx-fill: #5A64ED;"/>
                                <Label text="Resultados" styleClass="results-title"/>
                            </HBox>

                            <Label text="Aquí verás el análisis de tu texto." styleClass="card-subtitle"/>

                        </VBox>


                        <!-- Radio group -->
                        <fx:define>
                            <!--All RadioButtons share this ToggleGroup so only one analysis
                            category can be selected at a time.-->
                            <ToggleGroup fx:id="analysisGroup"/>
                        </fx:define>


                        <!-- Words -->
                        <HBox styleClass="result-item, palabras" spacing="15.0" alignment="CENTER_LEFT">

                            <!-- Reemplazo del "▤" por el SVG de documento dentro de la tarjeta -->
                            <Label styleClass="result-icon">
                                <graphic>
                                    <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" style="-fx-fill: white;"/>
                                </graphic>
                            </Label>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">

                                <Label text="Palabras" styleClass="result-name"/>

                                <Label fx:id="wordCountLabel" text="0" styleClass="result-count"/>

                                <Label text="Secuencias de letras" styleClass="result-description"/>

                            </VBox>

                            <RadioButton fx:id="wordsRadio" toggleGroup="$analysisGroup"/>

                        </HBox>


                        <!-- Vowels -->
                        <HBox styleClass="result-item, vocales" spacing="15.0" alignment="CENTER_LEFT">

                            <Label text="A" styleClass="result-icon"/>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">

                                <Label text="Vocales" styleClass="result-name"/>

                                <Label fx:id="vowelCountLabel" text="0" styleClass="result-count"/>

                                <Label text="a, e, i, o, u" styleClass="result-description"/>

                            </VBox>

                            <RadioButton fx:id="vowelsRadio"
                                         toggleGroup="$analysisGroup"/>

                        </HBox>


                        <!-- Consonants -->
                        <HBox styleClass="result-item, consonantes" spacing="15.0" alignment="CENTER_LEFT">

                            <Label text="B" styleClass="result-icon"/>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">

                                <Label text="Consonantes" styleClass="result-name"/>

                                <Label fx:id="consonantCountLabel" text="0" styleClass="result-count"/>

                                <Label text="Letras que no son vocales" styleClass="result-description"/>

                            </VBox>

                            <RadioButton fx:id="consonantsRadio" toggleGroup="$analysisGroup"/>

                        </HBox>


                        <!-- Digits -->
                        <HBox styleClass="result-item, digitos" spacing="15.0" alignment="CENTER_LEFT">

                            <Label text="1" styleClass="result-icon"/>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">

                                <Label text="Dígitos" styleClass="result-name"/>

                                <Label fx:id="digitCountLabel" text="0" styleClass="result-count"/>

                                <Label text="0 - 9" styleClass="result-description"/>

                            </VBox>

                            <RadioButton fx:id="digitsRadio" toggleGroup="$analysisGroup"/>

                        </HBox>


                        <!-- Special characters -->
                        <HBox styleClass="result-item, especiales" spacing="15.0" alignment="CENTER_LEFT">

                            <!-- "\" is used as an escape character to turn off the special meaning of resolution operators -->
                            <Label text="\@" styleClass="result-icon"/>

                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">

                                <Label text="Caracteres especiales" styleClass="result-name"/>

                                <Label fx:id="specialCountLabel" text="0" styleClass="result-count"/>

                                <Label text="No letras ni dígitos (Se cuentan espacios)" styleClass="result-description"/>

                            </VBox>

                            <RadioButton fx:id="specialRadio" toggleGroup="$analysisGroup"/>

                        </HBox>

                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>